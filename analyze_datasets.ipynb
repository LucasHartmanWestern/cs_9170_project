    "# ============================================================\n",
    "# CELL 8 – FEATURE CORRELATIONS WITH PROTECTED ATTRIBUTE\n",
    "# ============================================================\n",
    "# Which PCA dimensions most strongly encode protected-group membership?\n",
    "# If PC1 = protected attribute, then generating along PC1 = changing group identity\n",
    "# rather than label — which is exactly what we DON'T want.\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "for ax, (ds_name, cfg) in zip(axes, DATASET_CONFIGS.items()):\n",
    "    d    = DATA[ds_name]\n",
    "    X, y, a = d[\"X_tr\"], d[\"y_tr\"], d[\"a_tr\"]\n",
    "\n",
    "    # Point-biserial correlation of each PC with protected attr\n",
    "    corr_with_group  = [np.corrcoef(X[:, i], a)[0, 1] for i in range(PCA_COMPONENTS)]\n",
    "    corr_with_label  = [np.corrcoef(X[:, i], y)[0, 1] for i in range(PCA_COMPONENTS)]\n",
    "\n",
    "    x_pos = np.arange(PCA_COMPONENTS)\n",
    "    width = 0.38\n",
    "    ax.bar(x_pos - width/2, corr_with_group, width, alpha=0.75, color=\"#CC4444\", label=\"Corr with group (a)\")\n",
    "    ax.bar(x_pos + width/2, corr_with_label, width, alpha=0.75, color=\"#4477CC\", label=\"Corr with label (y)\")\n",
    "    ax.axhline(0, color=\"black\", lw=0.8)\n",
    "    ax.set_xticks(x_pos); ax.set_xticklabels([f\"PC{i+1}\" for i in x_pos])\n",
    "    ax.set_ylabel(\"Point-biserial correlation\")\n",
    "    ax.set_title(f\"{cfg['label']}  —  PC correlations with group & label\")\n",
    "    ax.legend(fontsize=9)\n",
    "\n",
    "    # Report dominant PCs\n",
    "    dom_group = int(np.argmax(np.abs(corr_with_group)))\n",
    "    dom_label = int(np.argmax(np.abs(corr_with_label)))\n",
    "    print(f\"{cfg['label']:20s}  \"\n",
    "          f\"PC most corr w/ group: PC{dom_group+1} (r={corr_with_group[dom_group]:+.3f})  \"\n",
    "          f\"PC most corr w/ label: PC{dom_label+1} (r={corr_with_label[dom_label]:+.3f})\")\n",
    "    if dom_group == dom_label:\n",
    "        print(f\"  ⚠ WARNING: same PC encodes both group and label → generating on PC{dom_group+1}\"\n",
    "              f\" simultaneously shifts group membership AND label prediction\")\n",
    "\n",
    "plt.suptitle(\"PCA Dimensions: Group vs Label Encoding\", fontsize=12, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()\n",
    "print(\"\\nIf a PC strongly correlates with BOTH group and label, generation in that direction\")\n",
    "print(\"may inadvertently change group identity — a confound for fairness augmentation.\")"
   ]
