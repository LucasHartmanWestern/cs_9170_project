    "# ============================================================\n",
    "# CELL 4 – PCA VARIANCE EXPLAINED + CLASS SEPARABILITY\n",
    "# ============================================================\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "for row, (ds_name, cfg) in enumerate(DATASET_CONFIGS.items()):\n",
    "    d = DATA[ds_name]\n",
    "    X, y, a = d[\"X_tr\"], d[\"y_tr\"], d[\"a_tr\"]\n",
    "\n",
    "    # Panel 1: cumulative variance explained\n",
    "    ax = axes[row, 0]\n",
    "    pca_full = PCA(n_components=min(20, X.shape[1])).fit(X)\n",
    "    cumvar = np.cumsum(pca_full.explained_variance_ratio_)\n",
    "    ax.bar(range(1, len(cumvar)+1), pca_full.explained_variance_ratio_,\n",
    "           alpha=0.6, color=\"steelblue\", label=\"Per-component\")\n",
    "    ax2 = ax.twinx()\n",
    "    ax2.plot(range(1, len(cumvar)+1), cumvar, c=\"red\", marker=\"o\", ms=4, label=\"Cumulative\")\n",
    "    ax2.axhline(0.90, color=\"red\", lw=0.8, ls=\"--\", alpha=0.5)\n",
    "    ax2.set_ylim(0, 1.05); ax2.set_ylabel(\"Cumulative var explained\", color=\"red\")\n",
    "    ax.set_xlabel(\"PC\"); ax.set_ylabel(\"Variance explained\")\n",
    "    ax.set_title(f\"{cfg['label']}\\nPCA variance explained\")\n",
    "    at_10 = cumvar[9] if len(cumvar) >= 10 else cumvar[-1]\n",
    "    print(f\"{cfg['label']:20s}  PC10 cumulative variance: {at_10:.3f}\")\n",
    "\n",
    "    # Panel 2: PC1 × PC2 coloured by class × group\n",
    "    ax = axes[row, 1]\n",
    "    styles = {\n",
    "        (0, 0): (\"#AAAACC\", \"o\", 6,  \"G0-Y0 (adv, neg)\"),\n",
    "        (0, 1): (cfg[\"color_min\"], \"^\", 18, \"G0-Y1 (adv, pos)\"),\n",
    "        (1, 0): (\"#CCAAAA\", \"o\", 6,  \"G1-Y0 (dis, neg)\"),\n",
    "        (1, 1): (cfg[\"color_maj\"], \"*\", 25, \"G1-Y1 (dis, pos) ← target\"),\n",
    "    }\n",
    "    for (g, l), (col, mk, sz, lbl) in styles.items():\n",
    "        mask = (a == g) & (y == l)\n",
    "        if mask.sum() == 0: continue\n",
    "        ax.scatter(X[mask, 0], X[mask, 1], c=col, marker=mk, s=sz,\n",
    "                   alpha=0.35, label=f\"{lbl} (n={mask.sum()})\")\n",
    "    ax.set_xlabel(\"PC1\"); ax.set_ylabel(\"PC2\")\n",
    "    ax.set_title(\"PC1 × PC2  (coloured by group × label)\")\n",
    "    ax.legend(fontsize=7, loc=\"upper right\")\n",
    "\n",
    "plt.suptitle(\"PCA Structure\", fontsize=13, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
