    "# ============================================================\n",
    "# CELL 9 – ANCHOR POOL QUALITY\n",
    "# ============================================================\n",
    "# How many usable hard-positive anchors exist?\n",
    "# What sigma is needed for useful anchor proximity reward?\n",
    "\n",
    "from scipy.spatial.distance import cdist\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "for ax, (ds_name, cfg) in zip(axes, DATASET_CONFIGS.items()):\n",
    "    d     = DATA[ds_name]\n",
    "    alpha = ALPHAS[ds_name]\n",
    "    X, y, a = d[\"X_tr\"], d[\"y_tr\"], d[\"a_tr\"]\n",
    "\n",
    "    # Anchor pool: disadvantaged-positive\n",
    "    pool_mask = (a == 1) & (y == 1)\n",
    "    pool      = X[pool_mask]\n",
    "\n",
    "    with torch.no_grad():\n",
    "        p1_pool = rh.p1_from_agent(alpha, torch.tensor(pool, dtype=torch.float32)).numpy()\n",
    "\n",
    "    # Nearest-neighbour distances within pool (for sigma calibration)\n",
    "    n_sample = min(300, len(pool))\n",
    "    sub      = pool[:n_sample]\n",
    "    D        = cdist(sub, sub)\n",
    "    np.fill_diagonal(D, np.inf)\n",
    "    nn_dists = D.min(axis=1)\n",
    "    median_nn = np.median(nn_dists)\n",
    "\n",
    "    # Panel: p_alpha distribution of pool + sigma calibration\n",
    "    ax.hist(p1_pool, bins=30, color=cfg[\"color_min\"], alpha=0.7, edgecolor=\"white\")\n",
    "    for top_k, ls in [(50, \":\"), (100, \"--\"), (150, \"-\")]:\n",
    "        if top_k <= len(p1_pool):\n",
    "            threshold = np.partition(p1_pool, top_k)[top_k-1]\n",
    "            ax.axvline(threshold, color=\"red\", lw=1.2, ls=ls, label=f\"top-{top_k} hard (p≤{threshold:.3f})\")\n",
    "    ax.axvline(0.5, color=\"black\", lw=0.9, ls=\":\", alpha=0.6)\n",
    "    ax.set_xlabel(\"p_alpha\"); ax.set_ylabel(\"Count\")\n",
    "    ax.set_title(f\"{cfg['label']}  —  Anchor pool (n={len(pool)})\\np_alpha distribution\")\n",
    "    ax.legend(fontsize=8)\n",
    "\n",
    "    # Sigma calibration summary\n",
    "    for factor in [1.0, 2.0, 3.5, 5.0]:\n",
    "        sigma = median_nn * factor\n",
    "        print(f\"  {cfg['label']:20s}  sigma_calibration_factor={factor:.1f}  → sigma={sigma:.4f}\")\n",
    "    print(f\"  {cfg['label']:20s}  pool_size={len(pool)}  median_nn_dist={median_nn:.4f}\")\n",
    "    print()\n",
    "\n",
    "    ax.annotate(f\"Pool: n={len(pool)}\\nMedian NN dist: {median_nn:.3f}\\n\"\n",
    "                f\"σ @factor=3.5: {median_nn*3.5:.3f}\",\n",
    "                xy=(0.98, 0.95), xycoords=\"axes fraction\", ha=\"right\", va=\"top\",\n",
    "                fontsize=9, bbox=dict(boxstyle=\"round\", fc=\"white\", alpha=0.8))\n",
    "\n",
    "plt.suptitle(\"Anchor Pool Quality & Sigma Calibration\", fontsize=12, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
