   "source": [
    "# ============================================================\n",
    "# CELL 5 – TRAIN ALPHA MODELS + PER-GROUP PERFORMANCE\n",
    "# ============================================================\n",
    "# Trains a fresh alpha on each dataset (same architecture as experiments).\n",
    "# Shows per-group TPR, FPR, F1 — revealing the structural fairness gap.\n",
    "\n",
    "ALPHAS = {}\n",
    "\n",
    "for ds_name, cfg in DATASET_CONFIGS.items():\n",
    "    d = DATA[ds_name]\n",
    "    print(f\"\\nTraining alpha on {ds_name}…\")\n",
    "\n",
    "    alpha = FFNNAgent(\n",
    "        input_size=PCA_COMPONENTS, hidden_sizes=[32, 16], output_size=2,\n",
    "        type=\"classification\", classes=[0, 1],\n",
    "        learning_rate=0.001, batch_size=64, epochs=10,\n",
    "        device=\"cpu\", seed=SEED,\n",
    "    )\n",
    "    X_tr_t = torch.tensor(d[\"X_tr\"], dtype=torch.float32)\n",
    "    y_tr_t = torch.tensor(d[\"y_tr\"], dtype=torch.long)\n",
    "    alpha.train(X_tr_t, y_tr_t)\n",
    "    ALPHAS[ds_name] = alpha\n",
    "    print(f\"  Done.\")\n",
    "\n",
    "# ── Per-group evaluation ──────────────────────────────────────\n",
    "fig, axes = plt.subplots(2, 3, figsize=(16, 9))\n",
    "\n",
    "for row, (ds_name, cfg) in enumerate(DATASET_CONFIGS.items()):\n",
    "    d     = DATA[ds_name]\n",
    "    alpha = ALPHAS[ds_name]\n",
    "    X_v   = torch.tensor(d[\"X_val\"], dtype=torch.float32)\n",
    "    y_v   = d[\"y_val\"]\n",
    "    a_v   = d[\"a_val\"]\n",
    "\n",
    "    with torch.no_grad():\n",
    "        p1 = rh.p1_from_agent(alpha, X_v).numpy()\n",
    "    preds = (p1 >= 0.5).astype(int)\n",
    "\n",
    "    groups   = sorted(np.unique(a_v))\n",
    "    tpr_list, fpr_list, f1_list, n_pos_list = [], [], [], []\n",
    "\n",
    "    for g in groups:\n",
    "        mask = a_v == g\n",
    "        y_g  = y_v[mask]; p_g  = preds[mask]; p1_g = p1[mask]\n",
    "        tp = ((p_g == 1) & (y_g == 1)).sum()\n",
    "        fn = ((p_g == 0) & (y_g == 1)).sum()\n",
    "        fp = ((p_g == 1) & (y_g == 0)).sum()\n",
    "        tn = ((p_g == 0) & (y_g == 0)).sum()\n",
    "        tpr_list.append(tp / max(tp + fn, 1))\n",
    "        fpr_list.append(fp / max(fp + tn, 1))\n",
    "        f1_list.append(f1_score(y_g, p_g, zero_division=0))\n",
    "        n_pos_list.append((y_g == 1).sum())\n",
    "\n",
    "    # Panel 1: TPR per group\n",
    "    ax = axes[row, 0]\n",
    "    bars = ax.bar([f\"Group {g}\" for g in groups], tpr_list,\n",
    "                  color=[\"#6688CC\", \"#CC6644\"], alpha=0.8)\n",
    "    for b, v in zip(bars, tpr_list):\n",
    "        ax.text(b.get_x()+b.get_width()/2, v+0.01, f\"{v:.3f}\", ha=\"center\", fontsize=10)\n",
    "    ax.set_ylim(0, 1.1); ax.axhline(np.mean(tpr_list), color=\"black\", ls=\"--\", lw=0.8, label=\"Mean TPR\")\n",
    "    ax.set_title(f\"{cfg['label']}\\nTPR per group  (EO gap = {abs(tpr_list[0]-tpr_list[1]):.3f})\")\n",
    "    ax.set_ylabel(\"TPR\"); ax.legend(fontsize=8)\n",
    "\n",
    "    # Panel 2: FPR per group\n",
    "    ax = axes[row, 1]\n",
    "    bars = ax.bar([f\"Group {g}\" for g in groups], fpr_list,\n",
    "                  color=[\"#6688CC\", \"#CC6644\"], alpha=0.8)\n",
    "    for b, v in zip(bars, fpr_list):\n",
    "        ax.text(b.get_x()+b.get_width()/2, v+0.005, f\"{v:.3f}\", ha=\"center\", fontsize=10)\n",
    "    ax.set_ylim(0, max(fpr_list)*1.4+0.05)\n",
    "    ax.set_title(\"FPR per group\"); ax.set_ylabel(\"FPR\")\n",
    "\n",
    "    # Panel 3: p1 distribution by group × label\n",
    "    ax = axes[row, 2]\n",
    "    a_v_arr = np.array(a_v)\n",
    "    for g, col, ls in [(0, \"#6688CC\", \"-\"), (1, \"#CC6644\", \"--\")]:\n",
    "        for l, alpha_val, lbl in [(0, 0.4, \"neg\"), (1, 0.85, \"pos\")]:\n",
    "            mask = (a_v_arr == g) & (y_v == l)\n",
    "            if mask.sum() < 5: continue\n",
    "            ax.hist(p1[mask], bins=30, density=True, alpha=alpha_val, color=col,\n",
    "                    linestyle=ls, histtype=\"stepfilled\",\n",
    "                    label=f\"G{g}-Y{l} (n={mask.sum()})\")\n",
    "    ax.axvline(0.5, color=\"black\", lw=1, ls=\":\")\n",
    "    ax.set_xlabel(\"p_alpha\"); ax.set_ylabel(\"Density\")\n",
    "    ax.set_title(\"p_alpha distribution by group × label\")\n",
    "    ax.legend(fontsize=7)\n",
    "\n",
    "    eo_gap = abs(tpr_list[0] - tpr_list[1])\n",
    "    print(f\"{cfg['label']:20s}  TPR G0={tpr_list[0]:.3f}  G1={tpr_list[1]:.3f}  \"\n",
    "          f\"EO_gap={eo_gap:.3f}  F1 G0={f1_list[0]:.3f}  G1={f1_list[1]:.3f}\")\n",
    "\n",
    "plt.suptitle(\"Alpha Model — Per-group Performance\", fontsize=13, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell_overlap",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 6 – PCA OVERLAP: HOW SEPARABLE IS DIS-POSITIVE FROM DIS-NEGATIVE?\n",
    "# ============================================================\n",
    "# This directly diagnoses why census is hard:\n",
    "# If dis-positive (minority group, positive label) and dis-negative are\n",
    "# heavily overlapping in PCA space, the RL agent can't easily generate\n",
    "# samples that will be predicted positive by the classifier.\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "\n",
    "for ax, (ds_name, cfg) in zip(axes, DATASET_CONFIGS.items()):\n",
    "    d     = DATA[ds_name]\n",
    "    alpha = ALPHAS[ds_name]\n",
    "    X, y, a = d[\"X_tr\"], d[\"y_tr\"], d[\"a_tr\"]\n",
    "\n",
    "    # Disadvantaged group only\n",
    "    dis_mask = (a == 1)\n",
    "    X_dis = X[dis_mask]; y_dis = y[dis_mask]\n",
    "    pos_mask = y_dis == 1; neg_mask = y_dis == 0\n",
    "\n",
    "    with torch.no_grad():\n",
    "        p1_dis = rh.p1_from_agent(alpha, torch.tensor(X_dis, dtype=torch.float32)).numpy()\n",
    "\n",
    "    # PC1 × PC2 scatter\n",
    "    ax.scatter(X_dis[neg_mask, 0], X_dis[neg_mask, 1],\n",
    "               s=10, c=\"#CCAAAA\", alpha=0.30, label=f\"Dis-negative (n={neg_mask.sum()})\")\n",
    "    sc = ax.scatter(X_dis[pos_mask, 0], X_dis[pos_mask, 1],\n",
    "                    s=20, c=p1_dis[pos_mask], cmap=\"RdYlGn\", vmin=0, vmax=1,\n",
    "                    alpha=0.70, label=f\"Dis-positive (n={pos_mask.sum()}, coloured by p_alpha)\")\n",
    "    plt.colorbar(sc, ax=ax, label=\"p_alpha (dis-positive)\")\n",
    "\n",
    "    ax.set_xlabel(\"PC1\"); ax.set_ylabel(\"PC2\")\n",
    "    ax.set_title(f\"{cfg['label']}  —  Disadvantaged group in PCA space\\n\"\n",
    "                 f\"Dis-positive coloured by p_alpha (red=hard, green=easy)\")\n",
    "    ax.legend(fontsize=8)\n",
    "\n",
    "    # Compute overlap score: median pairwise distance between pos and neg centroids\n",
    "    if pos_mask.sum() > 0 and neg_mask.sum() > 0:\n",
    "        centroid_pos = X_dis[pos_mask].mean(axis=0)\n",
    "        centroid_neg = X_dis[neg_mask].mean(axis=0)\n",
    "        dist_centroids = np.linalg.norm(centroid_pos - centroid_neg)\n",
    "        spread_pos     = np.linalg.norm(X_dis[pos_mask] - centroid_pos, axis=1).mean()\n",
    "        overlap_ratio  = spread_pos / (dist_centroids + 1e-9)\n",
    "        hard_fraction  = (p1_dis[pos_mask] < 0.5).mean()\n",
    "        print(f\"{cfg['label']:20s}  centroid_dist={dist_centroids:.3f}  \"\n",
    "              f\"pos_spread={spread_pos:.3f}  overlap_ratio={overlap_ratio:.2f}  \"\n",
    "              f\"hard_pos_fraction(p<0.5)={hard_fraction:.3f}\")\n",
    "        ax.annotate(f\"Centroid dist: {dist_centroids:.2f}\\n\"\n",
    "                    f\"Pos spread: {spread_pos:.2f}\\n\"\n",
    "                    f\"Hard fraction: {hard_fraction:.2f}\",\n",
    "                    xy=(0.02, 0.02), xycoords=\"axes fraction\",\n",
    "                    fontsize=9, bbox=dict(boxstyle=\"round\", fc=\"white\", alpha=0.7))\n",
    "\n",
    "plt.suptitle(\"Disadvantaged Group Separability in PCA Space\", fontsize=12, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()\n",
    "print(\"\\nHigh overlap_ratio = pos/neg classes mixed → hard for RL to generate useful samples\")\n",
    "print(\"Low hard_pos_fraction = most dis-positive are already easy for alpha → fewer anchor candidates\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell_boundary",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 7 – DECISION BOUNDARY GEOMETRY\n",
    "# ============================================================\n",
    "# How wide is the uncertain region (0.3 < p_alpha < 0.7) for each group?\n",
    "# Wider uncertain band = more room for the RL agent to have impact.\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
    "\n",
    "for ax, (ds_name, cfg) in zip(axes, DATASET_CONFIGS.items()):\n",
    "    d     = DATA[ds_name]\n",
    "    alpha = ALPHAS[ds_name]\n",
    "    X, y, a = d[\"X_tr\"], d[\"y_tr\"], d[\"a_tr\"]\n",
    "\n",
    "    with torch.no_grad():\n",
    "        p1 = rh.p1_from_agent(alpha, torch.tensor(X, dtype=torch.float32)).numpy()\n",
    "\n",
    "    # p1 histograms per group × label\n",
    "    for g, col, ls in [(0, \"#5577BB\", \"-\"), (1, \"#BB5533\", \"--\")]:\n",
    "        mask_pos = (a == g) & (y == 1)\n",
    "        mask_neg = (a == g) & (y == 0)\n",
    "        if mask_pos.sum() > 5:\n",
    "            ax.hist(p1[mask_pos], bins=40, density=True, alpha=0.55, color=col,\n",
    "                    histtype=\"step\", lw=2, linestyle=ls,\n",
    "                    label=f\"G{g}-positive (n={mask_pos.sum()})\")\n",
