    "# ============================================================\n",
    "# CELL 10 – DIAGNOSTIC SUMMARY TABLE\n",
    "# ============================================================\n",
    "\n",
    "from IPython.display import display\n",
    "\n",
    "rows = []\n",
    "for ds_name, cfg in DATASET_CONFIGS.items():\n",
    "    d     = DATA[ds_name]\n",
    "    alpha = ALPHAS[ds_name]\n",
    "    X, y, a = d[\"X_tr\"], d[\"y_tr\"], d[\"a_tr\"]\n",
    "\n",
    "    with torch.no_grad():\n",
    "        p1 = rh.p1_from_agent(alpha, torch.tensor(X, dtype=torch.float32)).numpy()\n",
    "\n",
    "    # Class imbalance\n",
    "    min_pct = (y == 1).mean() * 100\n",
    "\n",
    "    # Group imbalance (disadvantaged)\n",
    "    dis_pct = (a == 1).mean() * 100\n",
    "\n",
    "    # EO gap\n",
    "    tpr_g0 = ((p1 >= 0.5) & (y == 1) & (a == 0)).sum() / max(((y==1) & (a==0)).sum(), 1)\n",
    "    tpr_g1 = ((p1 >= 0.5) & (y == 1) & (a == 1)).sum() / max(((y==1) & (a==1)).sum(), 1)\n",
    "    eo_gap = abs(tpr_g0 - tpr_g1)\n",
    "\n",
    "    # Hard anchor pool\n",
    "    pool_mask = (a == 1) & (y == 1)\n",
    "    pool = X[pool_mask]\n",
    "    p1_pool = p1[pool_mask]\n",
    "    hard_anc_50 = (p1_pool < 0.5).sum()\n",
    "\n",
    "    # Uncertain zone width\n",
    "    uncertain_dis_pos = ((p1_pool > 0.3) & (p1_pool < 0.7)).mean() * 100\n",
    "\n",
    "    # PC1 correlations\n",
    "    corr_g = abs(np.corrcoef(X[:, 0], a)[0, 1])\n",
    "    corr_y = abs(np.corrcoef(X[:, 0], y)[0, 1])\n",
    "\n",
    "    # Sigma at factor=3.5\n",
    "    sub = pool[:min(300, len(pool))]\n",
    "    D   = cdist(sub, sub); np.fill_diagonal(D, np.inf)\n",
    "    sigma_35 = np.median(D.min(axis=1)) * 3.5\n",
    "\n",
    "    rows.append({\n",
    "        \"Dataset\":           cfg[\"label\"],\n",
    "        \"Minority %\":        f\"{min_pct:.1f}%\",\n",
    "        \"Dis. group %\":      f\"{dis_pct:.1f}%\",\n",
    "        \"Alpha EO gap\":      f\"{eo_gap:.4f}\",\n",
    "        \"Dis-pos pool\":      len(pool),\n",
    "        \"Hard anchors <0.5\": hard_anc_50,\n",
    "        \"Uncertain zone %\":  f\"{uncertain_dis_pos:.1f}%\",\n",
    "        \"|r(PC1, group)|\": f\"{corr_g:.3f}\",\n",
    "        \"|r(PC1, label)|\": f\"{corr_y:.3f}\",\n",
    "        \"σ @factor=3.5\":     f\"{sigma_35:.4f}\",\n",
    "    })\n",
    "\n",
    "df_summary = pd.DataFrame(rows).set_index(\"Dataset\")\n",
    "\n",
    "def highlight_summary(col):\n",
    "    if col.name == \"Alpha EO gap\":\n",
    "        return [\"background-color: #ffe0e0\" if float(v) > 0.2 else \"\" for v in col]\n",
    "    if col.name == \"Hard anchors <0.5\":\n",
    "        return [\"background-color: #ffe0e0\" if int(v) < 50 else \"\" for v in col]\n",
    "    return [\"\" for _ in col]\n",
    "\n",
    "print(\"\\n━━━━  DATASET DIAGNOSTIC SUMMARY  ━━━━\")\n",
    "print(\"Red = potential problem area\\n\")\n",
    "display(df_summary.style.apply(highlight_summary))"
   ]
