   "id": "intro",
   "metadata": {},
   "source": [
    "# Dataset Diagnostics\n",
    "\n",
    "Answers the key question: **why is each dataset hard for our fairness RL method?**\n",
    "\n",
    "**Sections**\n",
    "1. Setup & load both datasets\n",
    "2. Class and group distribution\n",
    "3. PCA — variance explained + class separability\n",
    "4. Group × label structure (who is the minority group?)\n",
    "5. Alpha model baseline — per-group performance\n",
    "6. Fairness gap diagnosis — is the gap structural or fixable?\n",
    "7. PCA-space overlap — how mixed are minority-positive vs minority-negative?\n",
    "8. Feature–protected-attribute correlations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell_setup",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 1 – SETUP\n",
    "# ============================================================\n",
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "PROJECT_ROOT = Path(\"/home/epigou/cs_9170_project\")\n",
    "sys.path.insert(0, str(PROJECT_ROOT))\n",
    "\n",
    "import json\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "import torch\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.metrics import roc_auc_score, f1_score\n",
    "\n",
    "from dataset import Dataset\n",
    "from agents.ffnn_agent2 import FFNNAgent\n",
    "import reward_helpers as rh\n",
    "\n",
    "SEED = 42\n",
    "PCA_COMPONENTS = 10\n",
    "REAL_DATA_SIZE = 3000\n",
    "\n",
    "DATASET_CONFIGS = {\n",
    "    \"census_income\": {\"minority_id\": 1, \"majority_id\": 0, \"label\": \"Census Income\",\n",
    "                      \"color_min\": \"#4477CC\", \"color_maj\": \"#CC7744\"},\n",
    "    \"credit_card\":   {\"minority_id\": 1, \"majority_id\": 0, \"label\": \"Credit Card\",\n",
    "                      \"color_min\": \"#44AA77\", \"color_maj\": \"#AA4477\"},\n",
    "}\n",
    "\n",
    "print(\"Setup complete.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell_load",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 2 – LOAD BOTH DATASETS\n",
    "# ============================================================\n",
    "\n",
    "DATA = {}\n",
    "\n",
    "for ds_name, cfg in DATASET_CONFIGS.items():\n",
    "    print(f\"\\nLoading {ds_name}…\")\n",
    "    ds = Dataset(\n",
    "        dataset_name=ds_name, multiclass=False,\n",
    "        minority_id=cfg[\"minority_id\"], majority_id=cfg[\"majority_id\"],\n",
    "        third_id=None, pca_components=PCA_COMPONENTS,\n",
    "        seed=SEED, device=\"cpu\", use_pca=True,\n",
    "    )\n",
    "    X_tr, X_val, X_te, y_tr, y_val, y_te = ds.get_data_splits(\n",
    "        train_size=REAL_DATA_SIZE, bias_pct=None,\n",
    "        pca_components=PCA_COMPONENTS, drop_protected=False,\n",
    "        protected_cols=ds.protected_attributes, bias_val=True,\n",
    "    )\n",
    "    X_tr_np = X_tr.numpy(); y_tr_np = y_tr.numpy()\n",
    "    X_te_np = X_te.numpy(); y_te_np = y_te.numpy()\n",
    "    a_tr    = ds.a_train.numpy()\n",
    "    a_val   = ds.a_val.numpy()\n",
    "\n",
    "    DATA[ds_name] = dict(\n",
    "        ds=ds, X_tr=X_tr_np, y_tr=y_tr_np, X_te=X_te_np, y_te=y_te_np,\n",
    "        a_tr=a_tr, a_val=a_val,\n",
    "        X_val=X_val.numpy(), y_val=y_val.numpy(),\n",
    "    )\n",
    "    print(f\"  Train {X_tr_np.shape}  minority={y_tr_np.sum()}  majority={(y_tr_np==0).sum()}\")\n",
    "\n",
    "print(\"\\nAll datasets loaded.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell_distributions",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 3 – CLASS & GROUP DISTRIBUTION\n",
    "# ============================================================\n",
    "\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",
    "\n",
    "for row, (ds_name, cfg) in enumerate(DATASET_CONFIGS.items()):\n",
    "    d = DATA[ds_name]\n",
    "    y, a = d[\"y_tr\"], d[\"a_tr\"]\n",
    "    n = len(y)\n",
    "\n",
    "    # Panel 1: class balance\n",
    "    ax = axes[row, 0]\n",
    "    counts = [( y == 0).sum(), (y == 1).sum()]\n",
    "    bars = ax.bar([\"Majority (0)\", \"Minority (1)\"], counts,\n",
    "                  color=[cfg[\"color_maj\"], cfg[\"color_min\"]], alpha=0.8)\n",
    "    for b, c in zip(bars, counts):\n",
    "        ax.text(b.get_x() + b.get_width()/2, c + 10, f\"{c}\\n({100*c/n:.1f}%)\",\n",
    "                ha=\"center\", fontsize=9)\n",
    "    ax.set_title(f\"{cfg['label']}\\nClass balance (train)\"); ax.set_ylabel(\"Count\")\n",
    "\n",
    "    # Panel 2: protected group balance\n",
    "    ax = axes[row, 1]\n",
    "    g_counts = [(a == 0).sum(), (a == 1).sum()]\n",
    "    ax.bar([\"Group 0 (adv)\", \"Group 1 (dis)\"], g_counts,\n",
    "           color=[\"#888888\", \"#CC4444\"], alpha=0.8)\n",
    "    for i, c in enumerate(g_counts):\n",
    "        ax.text(i, c + 10, f\"{c}\\n({100*c/n:.1f}%)\", ha=\"center\", fontsize=9)\n",
    "    ax.set_title(\"Protected group balance\"); ax.set_ylabel(\"Count\")\n",
    "\n",
    "    # Panel 3: group × label cross-tab\n",
    "    ax = axes[row, 2]\n",
    "    combos = [(g, l) for g in [0, 1] for l in [0, 1]]\n",
    "    labels_c = [f\"G{g}–Y{l}\" for g, l in combos]\n",
    "    counts_c = [((a == g) & (y == l)).sum() for g, l in combos]\n",
    "    colors_c = [\"#AAAACC\", \"#4477CC\", \"#CCAAAA\", \"#CC7744\"]\n",
    "    bars = ax.bar(labels_c, counts_c, color=colors_c, alpha=0.85)\n",
    "    for b, c in zip(bars, counts_c):\n",
    "        ax.text(b.get_x() + b.get_width()/2, c + 5,\n",
    "                f\"{c}\\n({100*c/n:.1f}%)\", ha=\"center\", fontsize=8)\n",
    "    ax.set_title(\"Group × Label cross-tab\")\n",
    "\n",
    "    # Print TPR gap estimate\n",
    "    tpr_g0 = ((a == 0) & (y == 1)).sum() / max((a == 0).sum(), 1)\n",
    "    tpr_g1 = ((a == 1) & (y == 1)).sum() / max((a == 1).sum(), 1)\n",
    "    print(f\"{cfg['label']:20s}  base rate G0={tpr_g0:.3f}  G1={tpr_g1:.3f}  \"\n",
    "          f\"gap={abs(tpr_g0-tpr_g1):.3f}\")\n",
    "\n",
    "plt.suptitle(\"Dataset Distributions\", fontsize=13, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
