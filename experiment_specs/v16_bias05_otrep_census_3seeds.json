{
  "baseline": "gaussian_ot_repair",
  "dataset_name": "census_income",
  "multiclass": false,
  "bias_pct": 0.05,

  "minority_id": 1,
  "majority_id": 0,
  "third_id": null,

  "real_data_size": 3000,
  "seeds": [42, 0, 1],

  "ffnn": {
    "hidden_sizes": [32, 16],
    "lr": 0.001,
    "batch_size": 64,
    "epochs": 100
  },

  "ot_repair": {
    "lam": 1.0,
    "n_groups": 2,
    "cov_reg": 1e-5,
    "barycenter_iters": 100,
    "repair_test": true
  }
}
