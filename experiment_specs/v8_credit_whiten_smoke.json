{
  "dataset_name": "credit_card",
  "multiclass": false,
  "bias_pct": null,
  "reward_mode": "fairness",
  "lambda_schedule": [
    0.5,
    0.5
  ],
  "minority_id": 1,
  "majority_id": 0,
  "third_id": null,
  "use_pca": true,
  "pca_components": 10,
  "traj_length": 2000,
  "real_data_size": 3000,
  "total_episodes": 500,
  "curriculum_learning": true,
  "use_delta_actions": true,
  "delta_scale": 0.1,
  "delta_clip": 0.2,
  "pca_clip": null,
  "radius_clip": 5.0,
  "gen_both_classes": false,
  "seeds": [
    42
  ],
  "local_weights": {
    "w_anchor": 0.8,
    "w_hard": 0.15,
    "w_div": 0.05,
    "sigma_anchor": 0.85,
    "sigma_calibration_factor": 3.5,
    "rho_div": 0.6,
    "hard_margin": 0.65,
    "anchor_selection_mode": "hard_positive",
    "anchor_selection_top_k": 100,
    "anchor_refresh_interval": 300,
    "anchor_refresh_top_k": 100,
    "use_uncertainty_anchors": false
  },
  "reward_shaping": {
    "hard_from_beta": true,
    "local_squash_k": 4.0,
    "local_squash_center": 0.5,
    "global_sigmoid_k": 10.0
  },
  "ffnn": {
    "hidden_sizes": [
      32,
      16
    ],
    "learning_rate": 0.001,
    "batch_size": 64,
    "epochs": 10
  },
  "reinforce": {
    "hidden_sizes": [
      64,
      64
    ],
    "lr": 0.0003,
    "gamma": 0.99,
    "entropy_start": 0.02,
    "entropy_end": 0.005
  },
  "curriculum": {
    "start_dim": 2,
    "max_dim_cap": 20,
    "stage_count": 5,
    "schedule": "linear"
  },
  "benchmarks": {
    "run_ctgan": false,
    "run_ctabgan": false
  },
  "whiten_pca": true
}
